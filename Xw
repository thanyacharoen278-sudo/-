-- UPDATE UI
--==================================================

task.spawn(function()

	while Gui.Parent do

		pcall(function()

			local targets =
				GetTargets()

			local target =
				targets[1]

			if target and IsAlive(target) then

				local humanoid =
					GetHumanoid(target)

				if humanoid then

					TargetInfo.Text =
						"TARGET : " ..
						target.Name ..
						"\nHP : " ..
						math.floor(humanoid.Health) ..
						" / " ..
						math.floor(humanoid.MaxHealth)

				end

			else

				TargetInfo.Text =
					"TARGET : NONE\nHP : -"

			end

			if Settings.AimLock then

				local aimTarget =
					GetAimTarget()

				if aimTarget then

					AimInfo.Text =
						"AIM TARGET : " ..
						aimTarget.Name

				else

					AimInfo.Text =
						"AIM TARGET : NOT FOUND"

				end

			else

				AimInfo.Text =
					"AIM TARGET : NONE"

			end

		end)

		task.wait(0.1)
	end
end)

--==================================================
-- COMBAT LOOP
--==================================================

task.spawn(function()

	while Settings.Running do

		pcall(function()

			if Settings.Gather then
				GatherMonsters()
			end

			if Settings.AutoAttack then

				local targets =
					GetTargets()

				for _, enemy in ipairs(targets) do

					if not Settings.AutoAttack then
						break
					end

					AttackTarget(enemy)

					if Settings.FastAttack then
						task.wait(FAST_DELAY)
					else
						task.wait(NORMAL_DELAY)
					end

				end

			else

				task.wait(0.1)

			end

		end)
	end
end)

