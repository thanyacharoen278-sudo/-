--==================================================
-- CHARACTER
--==================================================

local function GetCharacter(player)
	return player and player.Character
end

local function GetRoot(character)

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(model)

	if not model then
		return nil
	end

	return model:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(model)

	local humanoid = GetHumanoid(model)

	return humanoid ~= nil
		and humanoid.Health > 0
end

--==================================================
-- GET TARGETS
--==================================================

local function GetTargets()

	local character = GetCharacter(LocalPlayer)
	local root = GetRoot(character)

	if not root then
		return {}
	end

	local targets = {}

	for _, enemy in ipairs(Enemies:GetChildren()) do

		if enemy:IsA("Model")
			and enemy ~= character then

			local humanoid = GetHumanoid(enemy)
			local enemyRoot = GetRoot(enemy)

			if humanoid
				and enemyRoot
				and humanoid.Health > 0 then

				local distance =
					(enemyRoot.Position - root.Position).Magnitude

				if distance <= RANGE then

					table.insert(targets, {
						Model = enemy,
						Distance = distance
					})

				end
			end
		end
	end

	table.sort(targets, function(a, b)
		return a.Distance < b.Distance
	end)

	local result = {}

	for i = 1, math.min(#targets, MAX_TARGETS) do
		table.insert(result, targets[i].Model)
	end

	return result
end

--==================================================
-- GATHER
--==================================================

local function GatherMonsters()

	local character = GetCharacter(LocalPlayer)
	local root = GetRoot(character)

	if not root then
		return
	end

	local targets = GetTargets()
	local count = #targets

	if count == 0 then
		return
	end

	for i, enemy in ipairs(targets) do

		if enemy
			and enemy.Parent
			and IsAlive(enemy) then

			local angle =
				((i - 1) / math.max(count, 1))
				* math.pi * 2

			local offset = Vector3.new(
				math.cos(angle) * GATHER_DISTANCE,
				0,
				math.sin(angle) * GATHER_DISTANCE
			)

			local position =
				root.Position + offset

			pcall(function()

				enemy:PivotTo(
					CFrame.lookAt(
						position,
						root.Position
					)
				)

			end)
		end
	end
end

--==================================================
-- ATTACK
--==================================================

local function AttackTarget(enemy)

	if not enemy
		or not enemy.Parent
		or not IsAlive(enemy) then

		return
	end

	local character = GetCharacter(LocalPlayer)
	local root = GetRoot(character)

	local enemyRoot = GetRoot(enemy)
	local humanoid = GetHumanoid(enemy)

	if not root
		or not enemyRoot
		or not humanoid then

		return
	end

	local distance =
		(enemyRoot.Position - root.Position).Magnitude

	if distance > RANGE then
		return
	end

	-- หันเข้าหาเป้าหมาย
	pcall(function()

		root.CFrame = CFrame.lookAt(
			root.Position,

			Vector3.new(
				enemyRoot.Position.X,
				root.Position.Y,
				enemyRoot.Position.Z
			)
		)

	end)

	-- 1 Hit
	pcall(function()
		humanoid:TakeDamage(DAMAGE)
	end)
end

--==================================================
-- FIND PLAYER
--==================================================

local function FindPlayerByName(name)

	if not name or name == "" then
		return nil
	end

	name = string.lower(name)

	-- Username
	for _, player in ipairs(Players:GetPlayers()) do

		if string.lower(player.Name) == name then
			return player
		end

	end

	-- DisplayName
	for _, player in ipairs(Players:GetPlayers()) do

		if string.lower(player.DisplayName) == name then
			return player
		end

	end

	-- Partial name
	for _, player in ipairs(Players:GetPlayers()) do

		if string.find(
			string.lower(player.Name),
			name,
			1,
			true
		) then

			return player

		end
	end

	return nil
end

--==================================================
-- AIM LOCK
--==================================================

local AimTarget = nil

local function GetAimTarget()

	if not Settings.AimLock then
		return nil
	end

	local target =
		FindPlayerByName(
			Settings.AimPlayerName
		)

	if not target
		or target == LocalPlayer then

		return nil
	end

	local character =
		GetCharacter(target)

	local humanoid =
		GetHumanoid(character)

	local root =
		GetRoot(character)

	if not character
		or not humanoid
		or not root
		or humanoid.Health <= 0 then

		return nil
	end

	local myCharacter =
		GetCharacter(LocalPlayer)

	local myRoot =
		GetRoot(myCharacter)

	if not myRoot then
		return nil
	end

	local distance =
		(root.Position - myRoot.Position).Magnitude

	if distance > RANGE then
		return nil
	end

	return target
end

--==================================================
-- AIM CAMERA
--==================================================

RunService.RenderStepped:Connect(function()

	if not Settings.AimLock then

		AimTarget = nil
		return

	end

	local target = GetAimTarget()

	AimTarget = target

	if not target then
		return
	end

	local character =
		GetCharacter(target)

	local root =
		GetRoot(character)

	local camera =
		workspace.CurrentCamera

	if not root or not camera then
		return
	end

	pcall(function()

		camera.CFrame =
			CFrame.lookAt(
				camera.CFrame.Position,
				root.Position
			)

	end)
end)

